# Copy to .env for local development. Never commit real values.

# --- Runtime ---
NODE_ENV=development
PORT=5000

# --- Database (PostgreSQL) ---
# Local: docker compose up -d db
# Production: a managed Postgres connection string with sslmode=require (e.g. Neon pooled URL).
DATABASE_URL=postgres://eventsphere:eventsphere@localhost:5434/eventsphere

# --- Authentication ---
# Long random string (at least 32 characters). Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN_DAYS=7

# --- Application URL / CORS ---
# Public origin of the web app, used in emails and the CSRF origin check.
APP_URL=http://localhost:5000
# Only needed when the frontend is hosted on a different origin than the API (comma separated).
CORS_ORIGINS=
# Restrict sign-up to these email domains (comma separated). Leave empty to allow any domain.
ALLOWED_EMAIL_DOMAINS=

# --- Payments (Razorpay) ---
# Leave empty to disable paid registrations; free events keep working.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (SMTP, optional) ---
# Registration confirmations are sent only when these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SRMAP EventSphere <no-reply@example.com>"

# --- Bootstrap (used only by `npm run create-admin`) ---
ADMIN_PASSWORD=
